# Copy to .env and fill in what you have. Everything is optional; unset providers
# report themselves as unconfigured instead of guessing.

# --- Model ---------------------------------------------------------------
# ANTHROPIC_API_KEY is read by the SDK directly (not AAD_-prefixed).
ANTHROPIC_API_KEY=
AAD_MODEL=claude-opus-5
AAD_MODEL_EFFORT=high
# anthropic | bedrock  (bedrock for VPC-resident deployments)
AAD_PROVIDER=anthropic
AAD_AWS_REGION=us-east-1

# --- Embeddings ----------------------------------------------------------
# local  = offline, deterministic, no key (default; fine for dev and for a
#          disconnected workshop, weaker retrieval quality)
# openai = text-embedding-3-large, production retrieval quality
AAD_EMBEDDING_BACKEND=local
AAD_OPENAI_API_KEY=
AAD_EMBEDDING_DIM=512

# --- Vector store --------------------------------------------------------
AAD_VECTOR_BACKEND=local
AAD_PINECONE_API_KEY=
# Full index host from the Pinecone console, e.g. my-index-abc123.svc.us-east-1.pinecone.io
AAD_PINECONE_INDEX=

# --- Document parsing ----------------------------------------------------
# local = txt/md, plus PDF when pypdf is installed
# llamaparse = layout-aware parsing for scanned and heavily-tabular manuals
AAD_PARSER_BACKEND=local
AAD_LLAMAPARSE_API_KEY=

# --- Commercial data providers -------------------------------------------
# No public APIs exist for these; use your own subscription endpoints.
AAD_TORQUE_API_BASE=
AAD_TORQUE_API_KEY=
AAD_LABOR_API_BASE=
AAD_LABOR_API_KEY=
AAD_PARTS_API_BASE=
AAD_PARTS_API_KEY=
AAD_OBD2_API_BASE=
AAD_OBD2_API_KEY=
AAD_WIRING_API_BASE=
AAD_WIRING_API_KEY=

# --- Shop economics ------------------------------------------------------
AAD_SHOP_LABOR_RATE=125
AAD_PARTS_MARKUP=0.35
AAD_TAX_RATE=0.0
