# Copy to .env and fill in what you have. Everything is optional; unset providers
# report themselves as unconfigured instead of guessing.

# --- Model ---------------------------------------------------------------
# ANTHROPIC_API_KEY is read by the SDK directly (not AAD_-prefixed).
ANTHROPIC_API_KEY=
AAD_MODEL=claude-opus-5
AAD_MODEL_EFFORT=high
# anthropic | bedrock  (bedrock for VPC-resident deployments)
AAD_PROVIDER=anthropic
AAD_AWS_REGION=us-east-1

# --- Embeddings ----------------------------------------------------------
# local  = offline, deterministic, no key (default; fine for dev and for a
#          disconnected workshop, weaker retrieval quality)
# openai = text-embedding-3-large, production retrieval quality
AAD_EMBEDDING_BACKEND=local
AAD_OPENAI_API_KEY=
AAD_EMBEDDING_DIM=512

# --- Vector store --------------------------------------------------------
AAD_VECTOR_BACKEND=local
AAD_PINECONE_API_KEY=
# Full index host from the Pinecone console, e.g. my-index-abc123.svc.us-east-1.pinecone.io
AAD_PINECONE_INDEX=

# --- Document parsing ----------------------------------------------------
# local = txt/md, plus PDF when pypdf is installed
# llamaparse = layout-aware parsing for scanned and heavily-tabular manuals
AAD_PARSER_BACKEND=local
AAD_LLAMAPARSE_API_KEY=

# --- Commercial data providers -------------------------------------------
# No public APIs exist for these; use your own subscription endpoints. Each is
# described by a JSON profile in src/aad/providers/profiles/ — the shipped
# profiles are UNVERIFIED placeholders and will need adjusting to your vendor's
# real API. Check state with `aad providers list`, then `aad providers test <name>`.
AAD_TORQUE_API_BASE=
AAD_TORQUE_API_KEY=
AAD_LABOR_API_BASE=
AAD_LABOR_API_KEY=
AAD_PARTS_API_BASE=
AAD_PARTS_API_KEY=
AAD_OBD2_API_BASE=
AAD_OBD2_API_KEY=
AAD_WIRING_API_BASE=
AAD_WIRING_API_KEY=

# Directory of JSON profile overrides, if you keep edited profiles outside the
# package (recommended, so upgrades don't clobber them).
AAD_PROVIDER_PROFILE_DIR=

# --- Shop economics ------------------------------------------------------
AAD_SHOP_LABOR_RATE=125
AAD_PARTS_MARKUP=0.35
AAD_TAX_RATE=0.0

# --- Production safety ---------------------------------------------------
# Turn this on for any deployment a technician can reach. It excludes every
# document flagged `"synthetic": true` in its .meta.json sidecar from all
# retrieval, so demo data cannot reach a bay. Verify with:
#   aad verify-index --production
AAD_PRODUCTION_MODE=false

# --- Live provider tests -------------------------------------------------
# Set to 1 to run tests against real external services (NHTSA). CI sets this
# in its dedicated live job; leave it unset for a hermetic local run.
AAD_LIVE_TESTS=0
